## Copy to .env and fill values for local development

# Database (used by APP_CONFIG__DB__URL)
APP_CONFIG__DB__URL=""

# Bot token exposed via APP_CONFIG__BOT__TOKEN (preferred) or BOT_TELEGRAM_TOKEN
APP_CONFIG__BOT__TOKEN=''

# Optional overrides for uvicorn / API
APP_CONFIG__UVICORN__HOST=0.0.0.0
APP_CONFIG__UVICORN__PORT=8000
APP_CONFIG__UVICORN__RELOAD=true

# FastAPI settings
APP_CONFIG__API__TITLE="Mafia Game API"
APP_CONFIG__API__DEBUG=true

# Logging
APP_CONFIG__LOGGING__LEVEL=INFO

# Backwards-compatible BOT env var (still supported by scripts)
BOT_TELEGRAM_TOKEN=''
BOT_API_URL=http://localhost:8000
